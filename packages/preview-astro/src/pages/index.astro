---
import { Code } from "astro:components";
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";
import { IconList } from "../components/iconlist";

const HOME_USAGE_REACT = `
import { FaBeerMugEmpty } from 'react-icons/fa6';

class Question extends React.Component {
  render() {
    return <h3> Lets go for a <FaBeerMugEmpty />? </h3>
  }
}`;

const HOME_USAGE_SCOPED = `
import { FaBeerMugEmpty } from '@react-icons/fontawesome6';

class Question extends React.Component {
  render() {
    return <h3> Lets go for a <FaBeerMugEmpty />? </h3>
  }
}`;

const HOME_USAGE_FILES = `
import { FaBeerMugEmpty } from "@react-icons/fontawesome6_files/FaBeerMugEmpty";

class Question extends React.Component {
  render() {
    return <h3> Lets go for a <FaBeerMugEmpty />? </h3>
  }
}`;
---

<Layout title="React Icons">
  <Container title="React Icons">
    <p>
      <a href="https://www.npmjs.com/package/react-icons" rel="nofollow"
        ><img
          src="https://img.shields.io/npm/v/react-icons.svg"
          alt="npm"
          height="20"
        /></a
      >&emsp;<a
        href="https://github.com/react-icons/react-icons/actions"
        rel="nofollow"
        ><img
          src="https://github.com/react-icons/react-icons/actions/workflows/nodejs.yml/badge.svg"
          alt="GitHub Actions build status"
          height="20"
        /></a
      >
    </p>

    <p>
      Include popular icons in your React projects easily with react-icons,
      which utilizes ES6 imports that allows you to include only the icons that
      your project is using.
    </p>

    <h2>Include icon sets</h2>
    <IconList />

    <h2>Installation</h2>
    <Code lang="bash" code={`npm install react-icons`} />

    <h3>Usage</h3>
    <Code lang="jsx" code={HOME_USAGE_REACT} />

    <h2>Install a single icon set (v6.0.0+)</h2>
    <p>Install only the icon set you need with its scoped package.</p>
    <Code lang="bash" code={`npm install @react-icons/fontawesome6`} />
    <Code lang="jsx" code={HOME_USAGE_SCOPED} />

    <h2>Install individual icon files (v6.0.0+)</h2>
    <p>
      Install the files package when your environment requires each icon to have
      its own module. The package root cannot be imported.
    </p>
    <Code lang="bash" code={`npm install @react-icons/fontawesome6_files`} />

    <h3>Usage</h3>
    <Code lang="jsx" code={HOME_USAGE_FILES} />

    <h2>More info</h2>
    <p>
      <a href="https://github.com/react-icons/react-icons">GitHub &#8599;</a>
    </p>
  </Container>
</Layout>
